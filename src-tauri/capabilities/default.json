{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "os:default",
    {
      "identifier": "sql:allow-execute",
      "allow": [
        { "db": "sqlite:axisai.db" }
      ]
    },
    {
      "identifier": "sql:allow-load",
      "allow": [
        { "db": "sqlite:axisai.db" }
      ]
    },
    {
      "identifier": "sql:allow-select",
      "allow": [
        { "db": "sqlite:axisai.db" }
      ]
    },
    "sql:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/AxisAI-Vault" },
        { "path": "$DOCUMENT/AxisAI-Vault/**" }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "name": "url", "cmd": "open", "args": false }
      ]
    }
  ]
}
