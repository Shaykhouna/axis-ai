{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axis-Ai",
  "version": "0.1.0-alpha",
  "identifier": "app.xettali.tech.axisai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axis-Ai",
        "width": 1000,
        "height": 1000,
        "minWidth": 980,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": { "preload": [] },
    "updater": {
      "endpoints": [
        "https://github.com/Shaykhouna/axis-ai/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NEVBRTc2QjRENDQ5REYKUldUZlNkUzBkcTVPNUJpa3pUcVI1Slp3OTA3aFN0QXJBMHpxZFk1dVJSSUtLLzBmT1p6UGhaeVgK",
      "windows": {
        "installMode": "passive"
      },
      "dialog": true
    }
  }
}
